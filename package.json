{
  "name": "river-room-poker",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "concurrently -k -n SERVER,WEB -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm --workspace @river-room/server run dev",
    "dev:web": "npm --workspace @river-room/web run dev -- --host 0.0.0.0",
    "build": "npm run build --workspace @river-room/server && npm run build --workspace @river-room/web",
    "start": "npm --workspace @river-room/server run start",
    "test": "npm run test --workspace @river-room/server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
